  "%c ANALOG-GAUGE-CARD %c 4.1.2 ",
  "color:white;background:#111;padding:4px 8px;border-radius:4px 0 0 4px",
  "color:#111;background:#ddd;padding:4px 8px;border-radius:0 4px 4px 0"
);
